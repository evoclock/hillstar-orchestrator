# Build, packaging and environments
build/
dist/
sdist/
wheels/
downloads/
develop-eggs/
eggs/
.eggs/
parts/
var/
lib/
lib64/
*.egg
*.egg-info/
.installed.cfg
.Python
venv/
env/
ENV/
.venv

# Python bytecode and native artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches, coverage and test output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.test-results/
tmp_test/

# Generated documentation
docs/sphinx/_build/
docs/**/generated/

# Logs, run artifacts and local data
*.log
*.jsonl
audit/
results/
data/
deprecated/
tmp/

# Editor, tooling and OS state
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.markdownlintrc*
.obsidian/

# Local-only working directories.
# Development notes, planning, agent configuration and tool state stay on the
# machine. Listing each one by name would publish the shape of what is private,
# so these are matched by pattern rather than enumerated.
dev/
scripts/
hooks/
.claude/
.agent_*/
.chorus/
.hillstar/
.mistral_vibe/
*-logs/
**/troubleshoot/
**/sprint/

# Credentials and secrets. Never committed.
.env
.env.*
*.key
*.pem
*credentials*
secrets*
auth.json
